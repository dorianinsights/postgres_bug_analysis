    given-names: Josh
    affiliation: "Dorian Insights, L.L.C."
  - name: "Dorian Insights, L.L.C."
    website: "https://dorianinsights.com/"
repository-code: "https://github.com/dorianinsights/postgres_bug_analysis"
license: MIT
date-released: 2026-09-28
keywords:
  - PostgreSQL
  - bug fixes
  - release analysis
  - LLM
  - dbt
  - DuckDB

# Copy to .env (gitignored) and fill in. Secrets and per-machine settings only:
# analysis parameters live in vars.yml (dbt) and python/pg_analysis/corpus.py.

# A free postgresql.org community account, for the mailing-list sync
# (pg-mail-sync). The environment overrides these.
POSTGRES_COMM_USERNAME=
POSTGRES_COMM_PASSWORD=

# The Ollama server the LLM classifiers and pg-embed-fixes call, default
# http://localhost:11434. Read from the shell environment, NOT from this file:
# export it (e.g. `export OLLAMA_HOST=http://gpu-box:11434`) to point elsewhere.
# OLLAMA_HOST=

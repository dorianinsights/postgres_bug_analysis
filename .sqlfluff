[sqlfluff]
dialect = duckdb
# jinja (not dbt) templater: sqlfluff ships dummy ref/source/config builtins,
# which is all these models need — no dbt project compile per lint.
templater = jinja
max_line_length = 400
# ST06 (column order) excluded; ST07 (structure.using) deliberately stays
# ENABLED — USING joins are forbidden, always spell out the join type and
# ON <left>.<col> = <right>.<col>.
exclude_rules = ST06

# Load the project macros so calls like {{ person_key(...) }} expand during
# lint (the built-in dummy ref/source/config cover the rest). Pure-SQL
# macros only — no dbt compile.
[sqlfluff:templater:jinja]
load_macros_from_path = transform/macros

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = True
ignore_comment_clauses = True

[sqlfluff:rules:aliasing.length]
min_alias_length = 3

[sqlfluff:indentation]
tab_space_size = 2

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower
[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = c_style

# "version" is a core domain identifier (a PostgreSQL release version, e.g.
# "18.6") used as a column name throughout the pipeline. Let RF04 allow it so a
# model can alias an expression to it (int_releases builds it from major.minor).
[sqlfluff:rules:references.keywords]
ignore_words = version

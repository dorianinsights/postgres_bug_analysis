[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 400
exclude_rules = ST06

[sqlfluff:templater:dbt]
project_dir = transform
profiles_dir = transform
# Compile against the real warehouse (transform/transform.duckdb) READ-ONLY --
# sqlfluff runs from the repo root, so the lint target's path is repo-root
# relative and it opens read-only (no write lock, no stray root-level stub).
target = lint

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = True
ignore_comment_clauses = True

[sqlfluff:rules:aliasing.length]
min_alias_length = 3

[sqlfluff:indentation]
tab_space_size = 2

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower
[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = c_style

# "version" is a core domain identifier (a PostgreSQL release version, e.g.
# "18.6") used as a column name throughout the pipeline. Let RF04 allow it so a
# model can alias an expression to it (int_releases builds it from major.minor).
[sqlfluff:rules:references.keywords]
ignore_words = version
